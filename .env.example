# App
NODE_ENV=development
PORT=5191
APP_NAME=Notarix Backend
APP_URL=http://localhost:5191
API_PREFIX=/api/v1
CLIENT_APP_URL=http://localhost:3000
ADMIN_APP_URL=http://localhost:5173

# Database
MONGODB_URI=mongodb://127.0.0.1:27017/notarix
MONGODB_DB_NAME=notarix

# Authentication
JWT_ACCESS_SECRET=replace_with_long_random_access_secret
JWT_REFRESH_SECRET=replace_with_long_random_refresh_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
PASSWORD_RESET_TOKEN_EXPIRES_IN_MINUTES=30

# Cookies
COOKIE_SECRET=replace_with_cookie_secret
COOKIE_DOMAIN=localhost
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

# Email
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=change_me
SMTP_PASS=change_me
EMAIL_FROM_NAME=Notarix
EMAIL_FROM_ADDRESS=no-reply@example.com

# Storage
STORAGE_PROVIDER=s3
AWS_ACCESS_KEY_ID=change_me
AWS_SECRET_ACCESS_KEY=change_me
AWS_REGION=us-east-1
AWS_S3_BUCKET=notarix-local
AWS_S3_PUBLIC_BASE_URL=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Uploads
MAX_FILE_SIZE_MB=25
UPLOAD_TMP_DIR=tmp/uploads

# Realtime
SOCKET_CORS_ORIGIN=http://localhost:3000,http://localhost:5173

# Logging and observability
LOG_LEVEL=debug
REQUEST_ID_HEADER=x-request-id

# Payments
DEFAULT_CURRENCY=USD
DEFAULT_PAYOUT_RELEASE_DAYS=7
