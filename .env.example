# App
NODE_ENV=development
PORT=5191
APP_NAME=Notarix Backend
APP_URL=http://localhost:5191
API_PREFIX=/api/v1
CLIENT_APP_URL=http://localhost:3000
ADMIN_APP_URL=http://localhost:5173

# Database
MONGODB_URI=mongodb://127.0.0.1:27017/notarix
MONGODB_DB_NAME=notarix

# Bootstrap admin
SUPER_ADMIN_NAME=Notarix Super Admin
SUPER_ADMIN_EMAIL=admin@example.com
SUPER_ADMIN_PASSWORD=replace_with_strong_admin_password

# Authentication
JWT_ACCESS_SECRET=replace_with_long_random_access_secret
JWT_REFRESH_SECRET=replace_with_long_random_refresh_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
PASSWORD_RESET_TOKEN_EXPIRES_IN_MINUTES=30

# Cookies
COOKIE_SECRET=replace_with_cookie_secret
COOKIE_DOMAIN=localhost
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

# Security
BANK_INFO_ENCRYPTION_KEY=replace_with_bank_info_encryption_key

# Email
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=change_me
SMTP_PASS=change_me
EMAIL_FROM_NAME=Notarix
EMAIL_FROM_ADDRESS=no-reply@example.com

# Storage
STORAGE_PROVIDER=cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Uploads
MAX_FILE_SIZE_MB=25
UPLOAD_TMP_DIR=tmp/uploads

# Realtime
CORS_ORIGIN=http://localhost:3000,http://localhost:5173
SOCKET_CORS_ORIGIN=http://localhost:3000,http://localhost:5173

# Logging and observability
LOG_LEVEL=debug
REQUEST_ID_HEADER=x-request-id

# Rate limiting
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=25
API_RATE_LIMIT_WINDOW_MS=900000
API_RATE_LIMIT_MAX=300

# Payments
DEFAULT_CURRENCY=USD
DEFAULT_PAYOUT_RELEASE_DAYS=14

# Render production notes
# Set NODE_ENV=production in Render.
# Replace APP_URL with your Render service URL or custom domain.
# Replace MONGODB_URI with your managed MongoDB connection string.
# Replace JWT_ACCESS_SECRET, JWT_REFRESH_SECRET, BANK_INFO_ENCRYPTION_KEY,
# SUPER_ADMIN_PASSWORD, and the Cloudinary credentials with real values in
# Render environment variables.
# Replace CORS_ORIGIN and SOCKET_CORS_ORIGIN with your real frontend origins.
